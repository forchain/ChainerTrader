//@version=6
indicator('SuperTrend', 'My SuperT.', overlay = true, format = format.price, precision = 2, timeframe = '')

// ============================================================================
// Input parameters
// ============================================================================
Periods = input.int(title = 'ATR Period', defval = 10, group = 'Setup')
src = input(hl2, title = 'Source', group = 'Setup')
Multiplier = input.float(title = 'ATR Multiplier', step = 0.1, defval = 3.0, group = 'Setup')
changeATR = input.bool(title = 'Change ATR Calculation Method ?', defval = true, group = 'Setup')
showsignals = input.bool(title = 'Show Buy/Sell Signals ?', defval = true, group = 'Display')
highlighting = input.bool(title = 'Highlighter On/Off ?', defval = true, group = 'Display')

// Debug settings (timestamps in milliseconds, comma-separated)
// Example: '1763938800000,1764000000000'
debug_times = ''
// debug_times = '1763938800000,1764000000000'

// ============================================================================
// ATR calculation
// ============================================================================
atr2 = ta.sma(ta.tr, Periods)
atr = changeATR ? ta.atr(Periods) : atr2

// ============================================================================
// Raw up/dn calculation
// ============================================================================
up_raw = src - Multiplier * atr
dn_raw = src + Multiplier * atr

// ============================================================================
// Recursive up calculation: up := close[1] > up1 ? max(up, up1) : up
// ============================================================================
up = up_raw
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up

// ============================================================================
// Recursive dn calculation: dn := close[1] < dn1 ? min(dn, dn1) : dn
// ============================================================================
dn = dn_raw
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn

// ============================================================================
// Trend calculation: trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend
// ============================================================================
trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend

// Buy/Sell signals
buySignal = trend == 1 and trend[1] == -1
sellSignal = trend == -1 and trend[1] == 1

// ============================================================================
// Debug Logging (timestamps in milliseconds)
// Format consistent with Python implementation
// ============================================================================
should_debug = false
if str.length(debug_times) > 0
    debug_times_list = str.split(debug_times, ',')
    for i = 0 to array.size(debug_times_list) - 1
        debug_ts = str.tonumber(str.trim(array.get(debug_times_list, i)))
        if not na(debug_ts) and time == debug_ts
            should_debug := true
            break

if should_debug
    trend_prev = nz(trend[1], 1)
    log.info('===== SuperTrend Debug [time={0}] =====', time)
    log.info('Input: close={0} close_prev={1}', close, close[1])
    log.info('ATR({0}): atr={1} src={2}', Periods, atr, src)
    log.info('Raw: up_raw={0} dn_raw={1}', up_raw, dn_raw)
    log.info('Prev: up_prev={0} dn_prev={1} trend_prev={2}', up1, dn1, trend_prev)
    log.info('Calc: up={0} dn={1} trend={2}', up, dn, trend)
    log.info('Signal: buy={0} sell={1}', buySignal ? 1 : 0, sellSignal ? 1 : 0)

// ============================================================================
// Plot up/dn bands
// ============================================================================
upPlot = plot(trend == 1 ? up : na, title = 'Up Trend', style = plot.style_linebr, linewidth = 2, color = color.new(color.green, 0))
dnPlot = plot(trend == 1 ? na : dn, title = 'Down Trend', style = plot.style_linebr, linewidth = 2, color = color.new(color.red, 0))

// ============================================================================
// Plot buy/sell signals
// ============================================================================
plotshape(buySignal ? up : na, title = 'UpTrend Begins', location = location.absolute, style = shape.circle, size = size.tiny, color = color.new(color.green, 0))
plotshape(buySignal and showsignals ? up : na, title = 'Buy', text = 'Buy', location = location.absolute, style = shape.labelup, size = size.tiny, color = color.new(color.green, 0), textcolor = color.new(color.white, 0))
plotshape(sellSignal ? dn : na, title = 'DownTrend Begins', location = location.absolute, style = shape.circle, size = size.tiny, color = color.new(color.red, 0))
plotshape(sellSignal and showsignals ? dn : na, title = 'Sell', text = 'Sell', location = location.absolute, style = shape.labeldown, size = size.tiny, color = color.new(color.red, 0), textcolor = color.new(color.white, 0))

// ============================================================================
// Fill highlighting
// ============================================================================
mPlot = plot(ohlc4, title = '', style = plot.style_circles, linewidth = math.max(1, 0))
longFillColor = highlighting ? trend == 1 ? color.green : color.white : color.white
shortFillColor = highlighting ? trend == -1 ? color.red : color.white : color.white
fill(mPlot, upPlot, title = 'UpTrend Highligter', color = longFillColor)
fill(mPlot, dnPlot, title = 'DownTrend Highligter', color = shortFillColor)

// ============================================================================
// Alerts
// ============================================================================
alertcondition(buySignal, title = 'SuperTrend Buy', message = 'SuperTrend Buy!')
alertcondition(sellSignal, title = 'SuperTrend Sell', message = 'SuperTrend Sell!')
changeCond = trend != trend[1]
alertcondition(changeCond, title = 'SuperTrend Direction Change', message = 'SuperTrend has changed direction!')

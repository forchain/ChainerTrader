//@version=6
strategy("ChainerTrader", "[S]Chainer", overlay=true, format=format.price, precision=6, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1)

// ============================================================================
// ChainerTrader Strategy Template (v4)
// ============================================================================
// This is a template strategy using the ChainerTrader framework library.
// 
// To create a new strategy, simply implement:
//   - getLongSignal() => bool  (做多信号，如金叉)
//   - getShortSignal() => bool (做空信号，如死叉)
// 
// All other logic (stop loss, confirmation, breakeven, take profit, etc.) 
// is handled by the ChainerTrader library framework.
//
// Trading Modes:
//   - LONG_ONLY: 做多信号开多，做空信号平多
//   - SHORT_ONLY: 做空信号开空，做多信号平空
//   - BOTH: 做多信号开多，做空信号开空，离场靠止损/止盈/保本
// ============================================================================

import outliertony/ChainerTrader/3 as Lib

// ============================================================================
// Signal Parameters (Customize for your strategy)
// ============================================================================
// These parameters are specific to the signal generation logic.
// For MA Cross example:
fastLen = input.int(title="Fast SMA Length", defval=9, minval=1, group="Signal Parameters")
slowLen = input.int(title="Slow SMA Length", defval=21, minval=1, group="Signal Parameters")

// ============================================================================
// Chainer Framework Parameters
// ============================================================================
chainer_mode = input.string(title="Trading Mode", defval="LONG_ONLY", options=["LONG_ONLY", "SHORT_ONLY", "BOTH"], group="Chainer Framework")
chainer_stoploss_atr_mult = input.float(title="Stop loss ATR multiple (0 = disabled)", defval=0.0, step=0.1, group="Chainer Framework")
chainer_enter_need_confirm = input.bool(title="Require entry confirmation", defval=true, group="Chainer Framework", tooltip="If true, waits for price to break key bar high/low before entering.")
chainer_exit_need_confirm = input.bool(title="Require exit confirmation", defval=true, group="Chainer Framework", tooltip="If true, waits for price to break key bar high/low before exiting.")
chainer_enable_breakeven = input.bool(title="Enable breakeven", defval=true, group="Chainer Framework")
chainer_risk_reward_ratio = input.float(title="Risk/reward ratio (0 = disabled)", defval=0.0, step=0.1, group="Chainer Framework")

// 当账户净值低于初始资金的一定百分比时，不再开新仓（0 = 不限制）
chainer_min_equity_percent = input.float(
     title="Min equity (percent of initial) to open trade (0 = disabled)",
     defval=0.0,
     minval=0.0,
     maxval=100.0,
     step=1.0,
     group="Chainer Framework",
     tooltip="When > 0, new entries are disabled if current equity falls below this percentage of initial capital.")

// 自定义进出场信号（单个时间，单位：毫秒）。为 0 则使用信号函数作为默认信号。
chainer_long_time = input.time(title="Custom long signal time (ms, 0 = disabled)", defval=0, group="Chainer Framework")
chainer_short_time = input.time(title="Custom short signal time (ms, 0 = disabled)", defval=0, group="Chainer Framework")

chainer_debug_start_time = input.time(title="Debug start time (ms, 0 = disabled)", defval=0, group="Chainer Framework")

// ============================================================================
// Signal Generation Functions (TEMPLATE: Replace these for new strategies)
// ============================================================================
// These functions generate long/short signals. Replace them to implement
// different trading strategies while keeping the Chainer framework intact.
// Signal semantics are fixed:
//   - getLongSignal(): 做多条件（如金叉）
//   - getShortSignal(): 做空条件（如死叉）

// Calculate indicators for signals
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)

// Get long signal (returns true when long condition is met)
getLongSignal() =>
    // MA Cross example: Golden cross (fast crosses above slow)
    ta.crossover(fast, slow)

// Get short signal (returns true when short condition is met)
getShortSignal() =>
    // MA Cross example: Death cross (fast crosses below slow)
    ta.crossunder(fast, slow)

// ============================================================================
// Strategy State (managed by library)
// ============================================================================
var Lib.StrategyState state = Lib.initState()

// ============================================================================
// Framework Update - Process signals and get actions
// ============================================================================
output = Lib.updateFramework(
     state,
     strategy.position_size,
     barstate.isconfirmed,
     chainer_mode,
     chainer_stoploss_atr_mult,
     chainer_enter_need_confirm,
     chainer_exit_need_confirm,
     chainer_enable_breakeven,
     chainer_risk_reward_ratio,
     chainer_long_time,
     chainer_short_time,
     getLongSignal(),
     getShortSignal(),
     false,  // extraStopSignal - not used in template
     false,  // extraExitLongSignal - not used in template
     false,  // extraExitShortSignal - not used in template
     strategy.equity,
     strategy.initial_capital,
     chainer_min_equity_percent)  // minEquityPercent

// Update state
state := output.newState

// ============================================================================
// Execute Trading Actions
// ============================================================================
if output.shouldEntryLong
    strategy.entry("Long", strategy.long)

if output.shouldEntryShort
    strategy.entry("Short", strategy.short)

if output.shouldExitLong
    strategy.close("Long")

if output.shouldExitShort
    strategy.close("Short")

if output.shouldCloseAll
    strategy.close_all()

if output.shouldSetExit
    if strategy.position_size > 0
        strategy.exit("Exit", "Long", stop=output.exitStopPrice, limit=not na(output.exitLimitPrice) ? output.exitLimitPrice : na)
    else if strategy.position_size < 0
        strategy.exit("Exit", "Short", stop=output.exitStopPrice, limit=not na(output.exitLimitPrice) ? output.exitLimitPrice : na)

// ============================================================================
// Debug Logging
// ============================================================================
shouldDebug = chainer_debug_start_time > 0 and time >= chainer_debug_start_time
if shouldDebug
    log.info("===== ChainerTrader Strategy Debug [time={0}] =====", time)
    log.info("Position: size={0} direction={1}", strategy.position_size, state.currentDirection)
    log.info("Mode: {0}", chainer_mode)
    log.info("Trade: tradeId={0} pendingLong={1} pendingShort={2} step={3}", state.tradeId, state.pendingLong ? 1 : 0, state.pendingShort ? 1 : 0, state.breakevenStep)
    log.info("Risk: entryPrice={0} initialStop={1} stopPrice={2} slAtrMult={3} rr={4} breakeven={5}", state.entryPrice, state.initialStop, state.stopPrice, chainer_stoploss_atr_mult, chainer_risk_reward_ratio, chainer_enable_breakeven ? 1 : 0)

// ============================================================================
// Plots (Customize for your strategy)
// ============================================================================
// Plot signal indicators (MA Cross example)
plot(fast, title="Fast SMA", color=color.new(color.teal, 0))
plot(slow, title="Slow SMA", color=color.new(color.orange, 0))

// 做多/做空信号标记
plotshape(output.longSignal, title="Long Signal", text="L", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(output.shortSignal, title="Short Signal", text="S", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// 做多确认成功/失败标记
plotshape(output.longConfirmSignal, title="Long Confirm", text="", style=shape.flag, location=location.abovebar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(output.longFailSignal, title="Long Fail", text="", style=shape.xcross, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)

// 做空确认成功/失败标记
plotshape(output.shortConfirmSignal, title="Short Confirm", text="", style=shape.flag, location=location.belowbar, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
plotshape(output.shortFailSignal, title="Short Fail", text="", style=shape.xcross, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

// 止损和止盈线（仅在持仓时）
hasPosition = strategy.position_size != 0
plot(hasPosition and not na(state.stopPrice) ? state.stopPrice : na, title="Stop Loss", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(hasPosition and not na(state.takeProfitPrice) ? state.takeProfitPrice : na, title="Take Profit", color=color.new(color.teal, 0), linewidth=1, style=plot.style_linebr)

// 止损触发标记
plotshape(output.stopHitSignal, title="Stop Loss Hit", text="SL", style=shape.circle, location=location.belowbar, color=color.new(color.red, 0), size=size.tiny)

// 保本更新标记
plotshape(output.breakevenUpdated, title="Breakeven Updated", text="BE", style=shape.diamond, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)

//@version=6
strategy("ChainerTrader", "[S]Chainer", overlay=true, format=format.price, precision=6, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1)

// ============================================================================
// NOTE: ChainerTrader Strategy Template
// ============================================================================
// This is a template strategy for the ChainerTrader framework.
// To create a new strategy, simply replace the signal generation functions:
//   - getEntrySignal() => bool
//   - getExitSignal() => bool
// All other logic (stop loss, confirmation, breakeven, etc.) is handled by
// the framework and can be reused.
// ============================================================================

import outliertony/ChainerTrader/1 as ChainerTraderLib

// ============================================================================
// Signal Parameters (Customize for your strategy)
// ============================================================================
// These parameters are specific to the signal generation logic.
// For MA Cross example:
fastLen = input.int(title="Fast SMA Length", defval=9, minval=1, group="Signal Parameters")
slowLen = input.int(title="Slow SMA Length", defval=21, minval=1, group="Signal Parameters")

// ============================================================================
// Chainer Framework Parameters
// ============================================================================
chainer_allow_short = input.bool(title="Allow short", defval=false, group="Chainer Framework")
chainer_direction = input.string(title="Direction", defval="LONG", options=["LONG", "SHORT"], group="Chainer Framework")
chainer_stoploss_atr_mult = input.float(title="Stop loss ATR multiple (0 = disabled)", defval=0.0, step=0.1, group="Chainer Framework")
chainer_entry_need_confirm = input.bool(title="Require entry confirmation", defval=true, group="Chainer Framework")
chainer_exit_need_confirm = input.bool(title="Require exit confirmation", defval=true, group="Chainer Framework")
chainer_enable_breakeven = input.bool(title="Enable breakeven", defval=true, group="Chainer Framework")
chainer_risk_reward_ratio = input.float(title="Risk/reward ratio (0 = disabled)", defval=0.0, step=0.1, group="Chainer Framework")

// 自定义进出场信号（单个时间，单位：毫秒）。为 0 则使用信号函数作为默认信号。
chainer_entry_time = input.time(title="Custom entry time (ms, 0 = disabled)", defval=0, group="Chainer Framework")
chainer_exit_time = input.time(title="Custom exit time (ms, 0 = disabled)", defval=0, group="Chainer Framework")

chainer_debug_start_time = input.time(title="Debug start time (ms, 0 = disabled)", defval=0, group="Chainer Framework")

// ============================================================================
// Direction Setup
// ============================================================================
// v3: 方向与做空支持
// - 允许做空(chainer_allow_short=true)时，Direction 支持 LONG / SHORT。
// - 不允许做空时，内部方向强制为 LONG，SHORT 方向不产生交易。
dir = chainer_allow_short and chainer_direction == "SHORT" ? "SHORT" : "LONG"

// ============================================================================
// Signal Generation Functions (TEMPLATE: Replace these for new strategies)
// ============================================================================
// These functions generate entry/exit signals. Replace them to implement
// different trading strategies while keeping the Chainer framework intact.

// Get entry signal (returns true when entry condition is met)
getEntrySignal() =>
    // MA Cross example: Golden cross (fast crosses above slow)
    fast = ta.sma(close, fastLen)
    slow = ta.sma(close, slowLen)
    ta.crossover(fast, slow)

// Get exit signal (returns true when exit condition is met)
getExitSignal() =>
    // MA Cross example: Death cross (fast crosses below slow)
    fast = ta.sma(close, fastLen)
    slow = ta.sma(close, slowLen)
    ta.crossunder(fast, slow)

// ============================================================================
// Signal Processing (Direction-aware)
// ============================================================================
// Convert raw signals to direction-aware trading signals
longEntryRaw = getEntrySignal()          // 金叉
longExitRaw = getExitSignal()            // 死叉

// 如果用户配置了 input.time，则使用这些时间作为进出场信号；否则回退到信号函数。
useCustomEntry = chainer_entry_time > 0
useCustomExit = chainer_exit_time > 0

// Pine 的 time 为毫秒，input.time 也是毫秒级时间戳，可直接比较。
customEntrySignal = useCustomEntry and time == chainer_entry_time
customExitSignal = useCustomExit and time == chainer_exit_time

// 方向感知的交易信号：
// - LONG 方向：金叉进场，死叉出场
// - SHORT 方向（且允许做空）：死叉进场，金叉出场
// - 不允许做空但方向为 SHORT 时：不产生信号
dirIsLong = dir == "LONG"
canUseShortDir = chainer_allow_short and not dirIsLong
tradeEntrySignal = dirIsLong ? longEntryRaw : canUseShortDir ? longExitRaw : false
tradeExitSignal = dirIsLong ? longExitRaw : canUseShortDir ? longEntryRaw : false

// 若配置了自定义时间，则覆盖方向感知信号
effectiveEntrySignal = useCustomEntry ? customEntrySignal : tradeEntrySignal
effectiveExitSignal = useCustomExit ? customExitSignal : tradeExitSignal

// ============================================================================
// Trade State Management
// ============================================================================
var int tradeId = 0
var bool pendingEntry = false
var bool pendingExit = false
var int entryKeyBarIndex = na
var int exitKeyBarIndex = na
var float initialStop = na
var float stopPrice = na
var float entryPrice = na
var float takeProfitPrice = na
var int breakevenStep = 0

// ============================================================================
// Entry Logic: Signal Trigger, Stop Loss Calculation, Entry or Wait for Confirm
// ============================================================================
// 每根 K 线默认没有进/出场确认/失败标记
var bool entryConfirmSignal = false
var bool entryFailSignal = false
var bool exitConfirmSignal = false
var bool exitFailSignal = false

entryConfirmSignal := false
entryFailSignal := false
exitConfirmSignal := false
exitFailSignal := false

// 进场信号：记录关键K线索引，计算止损价
if effectiveEntrySignal and strategy.position_size == 0 and not pendingEntry
    // 使用通用库计算止损价（支持 ATR 倍数等逻辑）
    currentBarStopPrice = ChainerTraderLib.stopPrice(dir, bar_index, chainer_stoploss_atr_mult)
    
    if not na(currentBarStopPrice)
        tradeId += 1
        entryKeyBarIndex := bar_index
        initialStop := currentBarStopPrice
        stopPrice := initialStop
        entryPrice := na
        breakevenStep := 0
        
        // 如果需要确认，设置等待状态；否则立即进场
        pendingEntry := chainer_entry_need_confirm
        
        if not chainer_entry_need_confirm
            // 立即进场
            if dir == "LONG"
                strategy.entry("Long", strategy.long)
            else if chainer_allow_short
                strategy.entry("Short", strategy.short)
            entryPrice := close
            
            // 设置止损和止盈
            if chainer_risk_reward_ratio > 0
                tp = ChainerTraderLib.riskRewardPrice(dir, entryPrice, initialStop, chainer_risk_reward_ratio)
                if not na(tp)
                    takeProfitPrice := tp
            // 止损和止盈会在后续的 Stop Loss and Take Profit Management 部分统一设置

// ============================================================================
// Entry Confirmation (bar_close时检查，使用close价格)
// ============================================================================
// 确认是事后的策略，要等到K线完全出现，根据收盘价来判断
if barstate.isconfirmed and pendingEntry
    safeEntryKeyBarIndex = not na(entryKeyBarIndex) ? entryKeyBarIndex : bar_index
    entryConfirmStatus = ChainerTraderLib.entryConfirm(dir, safeEntryKeyBarIndex)
    
    if entryConfirmStatus == 1
        // 进场确认成功
        entryConfirmSignal := true
        pendingEntry := false
        
        // 执行进场
        if dir == "LONG"
            strategy.entry("Long", strategy.long)
        else if chainer_allow_short
            strategy.entry("Short", strategy.short)
        entryPrice := close
        breakevenStep := 0
        
        // 设置止损和止盈
        if chainer_risk_reward_ratio > 0
            tp = ChainerTraderLib.riskRewardPrice(dir, entryPrice, initialStop, chainer_risk_reward_ratio)
            if not na(tp)
                takeProfitPrice := tp
        // 止损和止盈会在后续的 Stop Loss and Take Profit Management 部分统一设置
        
    else if entryConfirmStatus == -1
        // 进场确认失败
        entryFailSignal := true
        pendingEntry := false
        entryKeyBarIndex := na
        exitKeyBarIndex := na
        entryPrice := na
        initialStop := na
        stopPrice := na
        breakevenStep := 0

// ============================================================================
// Exit Logic: Signal Trigger, Exit or Wait for Confirm
// ============================================================================
// 出场信号：记录关键K线索引
if effectiveExitSignal and strategy.position_size != 0 and not pendingExit
    exitKeyBarIndex := bar_index
    
    // 如果需要确认，设置等待状态；否则立即出场
    pendingExit := chainer_exit_need_confirm
    
    if not chainer_exit_need_confirm
        // 立即出场
        strategy.close("Long")
        strategy.close("Short")
        pendingEntry := false
        pendingExit := false
        entryKeyBarIndex := na
        exitKeyBarIndex := na
        entryPrice := na
        initialStop := na
        stopPrice := na
        breakevenStep := 0
        takeProfitPrice := na

// ============================================================================
// Exit Confirmation (bar_close时检查，使用close价格)
// ============================================================================
// 确认是事后的策略，要等到K线完全出现，根据收盘价来判断
if barstate.isconfirmed and pendingExit
    safeExitKeyBarIndex = not na(exitKeyBarIndex) ? exitKeyBarIndex : bar_index
    exitConfirmStatus = ChainerTraderLib.exitConfirm(dir, safeExitKeyBarIndex)
    
    if exitConfirmStatus == 1
        // 出场确认成功
        exitConfirmSignal := true
        pendingExit := false
        
        // 执行出场
        strategy.close("Long")
        strategy.close("Short")
        pendingEntry := false
        entryKeyBarIndex := na
        exitKeyBarIndex := na
        entryPrice := na
        initialStop := na
        stopPrice := na
        breakevenStep := 0
        takeProfitPrice := na
        
    else if exitConfirmStatus == -1
        // 出场确认失败
        exitFailSignal := true
        pendingExit := false
        exitKeyBarIndex := na

// ============================================================================
// Stop Loss and Take Profit Management (Real-time monitoring by TradingView)
// ============================================================================
// 止损是事前设置的保护价格，使用 strategy.exit() 的 stop 参数
// TradingView 会自动实时监控价格，一旦触及立即执行
// 注意：strategy.exit() 需要在每根K线上调用以保持止损/止盈设置有效
if strategy.position_size != 0 and not na(stopPrice) and not na(entryPrice)
    if strategy.position_size > 0  // Long position
        strategy.exit("Exit", "Long", stop=stopPrice, limit=not na(takeProfitPrice) ? takeProfitPrice : na)
    else if strategy.position_size < 0  // Short position
        strategy.exit("Exit", "Short", stop=stopPrice, limit=not na(takeProfitPrice) ? takeProfitPrice : na)

// ============================================================================
// Breakeven Management (bar_close时检查，使用close价格)
// ============================================================================
// 保本逻辑在K线完成时检查，使用收盘价判断是否达到保本条件
if barstate.isconfirmed and strategy.position_size != 0 and chainer_enable_breakeven and not na(entryPrice) and not na(initialStop)
    newStop = ChainerTraderLib.breakevenPrice(dir, entryPrice, initialStop)
    if not na(newStop)
        longDir = dir == "LONG"
        // 仅在有利方向上移动止损
        shouldUpdate = (longDir and (na(stopPrice) or newStop > stopPrice)) or (not longDir and (na(stopPrice) or newStop < stopPrice))
        
        if shouldUpdate
            stopPrice := newStop
            breakevenStep += 1
            
            // 更新 strategy.exit() 的 stop 参数（会在 Stop Loss Management 部分统一处理）

// ============================================================================
// Debug Logging
// ============================================================================
// 只有当 entryKeyBarIndex 有效时才查询关键K线数据
entryFound = false
entryTime = 0
entryHigh = 0.0
entryLow = 0.0
if not na(entryKeyBarIndex)
    [entryFound, entryTime, entryHigh, entryLow] = ChainerTraderLib.keyLevelsByBarIndex(entryKeyBarIndex)

// 只有当 exitKeyBarIndex 有效时才查询关键K线数据
exitFound = false
exitTime = 0
exitHigh = 0.0
exitLow = 0.0
if not na(exitKeyBarIndex)
    [exitFound, exitTime, exitHigh, exitLow] = ChainerTraderLib.keyLevelsByBarIndex(exitKeyBarIndex)

shouldDebug = chainer_debug_start_time > 0 and time >= chainer_debug_start_time
if shouldDebug
    log.info("===== ChainerTrader Strategy Debug [time={0}] =====", time)
    log.info("Position: size={0}", strategy.position_size)
    log.info("Dir: dir={0}", dir)
    log.info("Trade: tradeId={0} pendingEntry={1} pendingExit={2} step={3}", tradeId, pendingEntry ? 1 : 0, pendingExit ? 1 : 0, breakevenStep)
    log.info("EntryKey: barIndex={0} found={1} time={2} high={3} low={4}", entryKeyBarIndex, entryFound ? 1 : 0, entryTime, entryHigh, entryLow)
    log.info("ExitKey: barIndex={0} found={1} time={2} high={3} low={4}", exitKeyBarIndex, exitFound ? 1 : 0, exitTime, exitHigh, exitLow)
    log.info("Risk: entryPrice={0} initialStop={1} stopPrice={2} slAtrMult={3} rr={4} breakeven={5}", entryPrice, initialStop, stopPrice, chainer_stoploss_atr_mult, chainer_risk_reward_ratio, chainer_enable_breakeven ? 1 : 0)

// ============================================================================
// Plots (Customize for your strategy)
// ============================================================================
// Plot signal indicators (MA Cross example)
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
plot(fast, title="Fast SMA", color=color.new(color.teal, 0))
plot(slow, title="Slow SMA", color=color.new(color.orange, 0))

// 方向感知的进出场标记（含自定义时间逻辑）
plotshape(effectiveEntrySignal, title="Entry Signal", text="E", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(effectiveExitSignal, title="Exit Signal", text="X", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// 进场确认成功标记
plotshape(entryConfirmSignal, title="Entry Confirm", text="", style=shape.flag, location=location.abovebar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)

// 进场确认失败标记
plotshape(entryFailSignal, title="Entry Fail", text="", style=shape.xcross, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)

// 出场确认成功/失败标记
plotshape(exitConfirmSignal, title="Exit Confirm", text="", style=shape.flag, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
plotshape(exitFailSignal, title="Exit Fail", text="", style=shape.xcross, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

// 止损和止盈线（仅在持仓时）
plot(strategy.position_size != 0 and not na(stopPrice) ? stopPrice : na, title="Stop Loss", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size != 0 and not na(takeProfitPrice) ? takeProfitPrice : na, title="Take Profit", color=color.new(color.teal, 0), linewidth=1, style=plot.style_linebr)

